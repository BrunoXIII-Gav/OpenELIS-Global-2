						<font size="8.0"/>
					</textElement>
					<textFieldExpression><![CDATA["Todas las personas tenemos 2 copias o “alelos” del gen DMPK que heredamos de cada uno de nuestros padres. El gen DMPK tiene un número variable de repeticiones CTG. El diagnóstico molecular de la Distrofia Miotónica Tipo 1 o Enfermedad de Steinert se define por el número de repeticiones CTG del alelo más largo:"]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement x="31" y="54" width="760" height="32" uuid="35e32864-8274-4055-b9fd-737fb1a44682"/>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font size="15.0" isBold="true"/>
					</textElement>
					<text><![CDATA[PRUEBA GENÉTICA PARA LA GENOTIPIFICACIÓN DEL TRIPLETE CTG DEL GEN DMPK]]></text>
				</staticText>
				<staticText>
					<reportElement x="5" y="610" width="110" height="19" uuid="43df1be5-09bb-421f-8a16-46f033024453"/>
					<textElement verticalAlignment="Middle">
						<font size="12.0" isBold="true"/>
					</textElement>
					<text><![CDATA[CONCLUSIONES]]></text>
				</staticText>
				<textField isBlankWhenNull="true" textAdjust="StretchHeight">
					<reportElement x="5" y="631" width="85" height="19" uuid="12fc702b-77ee-4346-b8f2-6e83e4a6b427"/>
					<textElement>
						<font size="10.0"/>
					</textElement>
					<textFieldExpression><![CDATA["La presencia de"]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement x="5" y="679" width="180" height="15" uuid="4274bf0f-9962-4847-b01c-c8d5180a6b77"/>
					<textElement>
						<font size="9.0"/>
					</textElement>
					<text><![CDATA[Fecha de entrega de reporte:]]></text>
				</staticText>
				<textField isBlankWhenNull="true">
					<reportElement x="190" y="679" width="160" height="15" uuid="a040fb7b-bd5b-4dbb-9c2c-44e01333d01f"/>
					<textElement>
						<font size="9.0" isBold="true"/>
					</textElement>
