				</image>
				<line>
					<reportElement x="6" y="520" width="810" height="1" uuid="b5815337-c8b1-4c0a-b316-bab6a0506422"/>
				</line>
				<line>
					<reportElement x="5" y="630" width="807" height="1" uuid="9ad84320-78e0-4d04-b650-c6fa9152b6a8"/>
				</line>
				<textField isBlankWhenNull="true" textAdjust="StretchHeight">
					<reportElement x="31" y="546" width="786" height="20" uuid="3d27aa65-d64a-41f4-b35e-b1d2d5a7d368"/>
					<textElement>
						<font size="8.0"/>
					</textElement>
					<textFieldExpression><![CDATA["Perfil normal: Las personas no afectadas presentan hasta 34 repeticiones CTG."]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true" textAdjust="StretchHeight">
					<reportElement x="31" y="560" width="786" height="30" uuid="a66f7652-1f5a-48e7-bc35-8ac90e74dfab"/>
					<textElement>
						<font size="8.0"/>
					</textElement>
					<textFieldExpression><![CDATA["Perfil normal mutable (*): Las personas cuyo alelo de mayor tamaño se ubica en el rango de 35 a 49 repeticiones CTG podrían o no manifestar la enfermedad; sin embargo, sus descendientes tienen un mayor riesgo de expansión del número de repeticiones CTG, y eventualmente de manifestar la enfermedad."]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true" textAdjust="StretchHeight">
					<reportElement x="31" y="590" width="786" height="20" uuid="b05ead35-2efa-4b73-90dc-3c1f839a4593"/>
					<textElement>
						<font size="8.0"/>
					</textElement>
					<textFieldExpression><![CDATA["Perfil mutado: Las personas que poseen alelos ≥50 repeticiones CTG manifiestan o manifestarán la enfermedad."]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true" textAdjust="StretchHeight">
					<reportElement x="5" y="650" width="807" height="19" uuid="c71784bb-9693-4b3e-9133-046e932d7158"/>
					<textElement>
						<font size="10.0"/>
					</textElement>
					<textFieldExpression><![CDATA["Todo diagnóstico genético debe ser entregado en una consulta especializada de asesoramiento genético a cargo de un profesional capacitado."]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true" textAdjust="StretchHeight">
					<reportElement x="90" y="631" width="90" height="19" uuid="3763eacb-58ec-4a83-b4b6-9e8d21c50557"/>
					<textElement>
						<font size="10.0"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{dmpkAllele1}]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true" textAdjust="StretchHeight">
					<reportElement x="180" y="631" width="98" height="19" uuid="f4d76e74-4f62-4215-a208-22e9e0de49c7"/>
					<textElement>
						<font size="10.0"/>
					</textElement>
					<textFieldExpression><![CDATA["repeticiones CTG"]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true" textAdjust="StretchHeight">
					<reportElement x="278" y="631" width="123" height="19" uuid="80806b25-e6cb-4fe1-9c06-515804a02329"/>
