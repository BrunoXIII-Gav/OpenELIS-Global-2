<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
  <changeSet id="080-01-create-role-patient-search-restriction" author="openelis">
    <preConditions onFail="MARK_RAN"><not><tableExists tableName="role_patient_search_restriction" schemaName="clinlims" /></not></preConditions>
    <createTable tableName="role_patient_search_restriction" schemaName="clinlims">
      <column name="id" type="INTEGER" autoIncrement="true"><constraints primaryKey="true" nullable="false" /></column>
      <column name="role_id" type="INTEGER"><constraints nullable="false" /></column>
      <column name="criterion_key" type="VARCHAR(80)"><constraints nullable="false" /></column>
    </createTable>
    <addUniqueConstraint tableName="role_patient_search_restriction" schemaName="clinlims"
      columnNames="role_id, criterion_key" constraintName="uq_role_patient_search_restriction" />
    <addForeignKeyConstraint baseTableName="role_patient_search_restriction" baseColumnNames="role_id"
      baseTableSchemaName="clinlims" constraintName="fk_role_patient_search_restriction_role"
      referencedTableName="system_role" referencedColumnNames="id" referencedTableSchemaName="clinlims" />
    <rollback><dropTable tableName="role_patient_search_restriction" schemaName="clinlims" /></rollback>
  </changeSet>
</databaseChangeLog>
