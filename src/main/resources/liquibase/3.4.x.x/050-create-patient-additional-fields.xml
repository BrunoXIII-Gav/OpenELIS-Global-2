<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="050-001-create-patient-additional-field-def" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="patient_additional_field_def"/>
            </not>
        </preConditions>
        <createTable tableName="patient_additional_field_def">
            <column name="id" type="NUMERIC(10,0)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="field_key" type="VARCHAR(80)">
                <constraints nullable="false"/>
            </column>
            <column name="display_name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="field_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="required" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="default_value" type="VARCHAR(500)"/>
            <column name="max_length" type="INTEGER"/>
            <column name="metadata_json" type="TEXT"/>
            <column name="sys_user_id" type="NUMERIC(10,0)">
                <constraints nullable="false"/>
            </column>
            <column name="last_updated" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="patient_additional_field_def"
            columnNames="field_key"
            constraintName="uq_patient_additional_field_def_field_key"/>
        <createIndex tableName="patient_additional_field_def" indexName="idx_patient_additional_field_def_sort_order">
            <column name="sort_order"/>
        </createIndex>
        <createSequence sequenceName="patient_additional_field_def_seq" startValue="1" incrementBy="1"/>
        <rollback>
            <dropTable tableName="patient_additional_field_def"/>
            <dropSequence sequenceName="patient_additional_field_def_seq"/>
        </rollback>
    </changeSet>

    <changeSet id="050-002-create-patient-additional-field-option" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="patient_additional_field_option"/>
            </not>
        </preConditions>
        <createTable tableName="patient_additional_field_option">
            <column name="id" type="NUMERIC(10,0)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="field_def_id" type="NUMERIC(10,0)">
                <constraints nullable="false"/>
            </column>
            <column name="option_key" type="VARCHAR(80)">
                <constraints nullable="false"/>
            </column>
            <column name="option_label" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="sys_user_id" type="NUMERIC(10,0)">
                <constraints nullable="false"/>
            </column>
            <column name="last_updated" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="patient_additional_field_option"
            baseColumnNames="field_def_id"
            constraintName="fk_patient_additional_field_option_def"
            referencedTableName="patient_additional_field_def"
            referencedColumnNames="id"
            onDelete="CASCADE"/>
        <addUniqueConstraint tableName="patient_additional_field_option"
            columnNames="field_def_id, option_key"
            constraintName="uq_patient_additional_field_option_key"/>
        <createIndex tableName="patient_additional_field_option" indexName="idx_patient_additional_field_option_def">
            <column name="field_def_id"/>
        </createIndex>
        <createSequence sequenceName="patient_additional_field_option_seq" startValue="1" incrementBy="1"/>
        <rollback>
            <dropTable tableName="patient_additional_field_option"/>
            <dropSequence sequenceName="patient_additional_field_option_seq"/>
        </rollback>
    </changeSet>

    <changeSet id="050-003-create-patient-additional-field-value" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="patient_additional_field_value"/>
            </not>
        </preConditions>
        <createTable tableName="patient_additional_field_value">
            <column name="id" type="NUMERIC(10,0)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="patient_id" type="NUMERIC(10,0)">
                <constraints nullable="false"/>
            </column>
            <column name="field_def_id" type="NUMERIC(10,0)">
                <constraints nullable="false"/>
            </column>
            <column name="field_value" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="sys_user_id" type="NUMERIC(10,0)">
                <constraints nullable="false"/>
            </column>
            <column name="last_updated" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="patient_additional_field_value"
            baseColumnNames="patient_id"
            constraintName="fk_patient_additional_field_value_patient"
            referencedTableName="patient"
            referencedColumnNames="id"
            onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="patient_additional_field_value"
            baseColumnNames="field_def_id"
            constraintName="fk_patient_additional_field_value_field"
            referencedTableName="patient_additional_field_def"
            referencedColumnNames="id"/>
        <addUniqueConstraint tableName="patient_additional_field_value"
            columnNames="patient_id, field_def_id"
            constraintName="uq_patient_additional_field_value_pair"/>
        <createIndex tableName="patient_additional_field_value" indexName="idx_patient_additional_field_value_patient">
            <column name="patient_id"/>
        </createIndex>
        <createIndex tableName="patient_additional_field_value" indexName="idx_patient_additional_field_value_field">
            <column name="field_def_id"/>
        </createIndex>
        <createSequence sequenceName="patient_additional_field_value_seq" startValue="1" incrementBy="1"/>
        <rollback>
            <dropTable tableName="patient_additional_field_value"/>
            <dropSequence sequenceName="patient_additional_field_value_seq"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
