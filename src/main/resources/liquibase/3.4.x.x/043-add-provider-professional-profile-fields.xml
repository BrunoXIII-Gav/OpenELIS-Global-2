<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <changeSet id="043-01-add-provider-professional-profile-code-column" author="openelis">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="provider"/>
        <not>
          <columnExists tableName="provider" columnName="professional_profile_code"/>
        </not>
      </and>
    </preConditions>

    <addColumn tableName="provider">
      <column name="professional_profile_code" type="VARCHAR(64)"/>
    </addColumn>
  </changeSet>

  <changeSet id="043-02-add-provider-professional-initials-column" author="openelis">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="provider"/>
        <not>
          <columnExists tableName="provider" columnName="professional_initials"/>
        </not>
      </and>
    </preConditions>

    <addColumn tableName="provider">
      <column name="professional_initials" type="VARCHAR(25)"/>
    </addColumn>
  </changeSet>

  <changeSet id="043-03-add-provider-cbp-code-column" author="openelis">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="provider"/>
        <not>
          <columnExists tableName="provider" columnName="cbp_code"/>
        </not>
      </and>
    </preConditions>

    <addColumn tableName="provider">
      <column name="cbp_code" type="VARCHAR(32)"/>
    </addColumn>
  </changeSet>

  <changeSet id="043-04-add-order-provider-profile-config" author="openelis">
    <preConditions onFail="MARK_RAN">
      <sqlCheck expectedResult="1">
        SELECT CASE WHEN EXISTS (
          SELECT 1 FROM clinlims.site_information_domain WHERE name = 'sampleEntryConfig'
        ) THEN 1 ELSE 0 END
      </sqlCheck>
      <sqlCheck expectedResult="0">SELECT count(*) FROM clinlims.site_information WHERE name = 'orderProviderProfileCode'</sqlCheck>
    </preConditions>

    <insert schemaName="clinlims" tableName="site_information">
      <column name="id" valueSequenceNext="site_information_seq" />
      <column name="name" value="orderProviderProfileCode" />
      <column name="lastupdated" valueComputed="${now}" />
      <column name="description" value="Professional profile code used to filter providers in order entry" />
      <column name="value" value="MEDICAL_DOCTOR" />
      <column name="encrypted" value="false" />
      <column name="domain_id" valueComputed="(SELECT id FROM site_information_domain WHERE name = 'sampleEntryConfig')" />
      <column name="value_type" value="text" />
      <column name="group" value="0" />
    </insert>
  </changeSet>

  <changeSet id="043-05-backfill-provider-professional-profile-default" author="openelis">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="provider"/>
        <columnExists tableName="provider" columnName="professional_profile_code"/>
      </and>
    </preConditions>

    <update tableName="provider">
      <column name="professional_profile_code" value="MEDICAL_DOCTOR"/>
      <where>professional_profile_code IS NULL OR trim(professional_profile_code) = ''</where>
    </update>
  </changeSet>

</databaseChangeLog>
