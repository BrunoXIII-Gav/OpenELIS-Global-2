<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet author="codex" id="090-add-traceability-menu">
        <preConditions onFail="HALT">
            <sqlCheck expectedResult="1">SELECT COUNT(*) FROM clinlims.menu WHERE element_id = 'menu_reports_auditTrail'</sqlCheck>
            <sqlCheck expectedResult="1">SELECT COUNT(*) FROM clinlims.menu WHERE element_id = 'menu_reports_management'</sqlCheck>
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM clinlims.menu WHERE element_id = 'menu_traceability'</sqlCheck>
        </preConditions>
        <comment>Move the existing audit trail entry to an independently configurable top-level section.</comment>
        <insert tableName="menu" schemaName="clinlims">
            <column name="id" valueSequenceNext="menu_seq"/>
            <column name="presentation_order" valueNumeric="105"/>
            <column name="element_id" value="menu_traceability"/>
            <column name="action_url" value=""/>
            <column name="display_key" value="banner.menu.traceability"/>
            <column name="tool_tip_key" value="banner.menu.traceability"/>
            <column name="new_window" valueBoolean="false"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="hide_in_old_ui" valueBoolean="true"/>
        </insert>
        <update tableName="menu" schemaName="clinlims">
            <column name="parent_id" valueComputed="(SELECT id FROM clinlims.menu WHERE element_id = 'menu_traceability')"/>
            <column name="presentation_order" valueNumeric="1"/>
            <where>element_id = 'menu_reports_auditTrail'</where>
        </update>
        <rollback>
            <update tableName="menu" schemaName="clinlims">
                <column name="parent_id" valueComputed="(SELECT id FROM clinlims.menu WHERE element_id = 'menu_reports_management')"/>
                <column name="presentation_order" valueNumeric="70"/>
                <where>element_id = 'menu_reports_auditTrail'</where>
            </update>
            <delete tableName="menu" schemaName="clinlims">
                <where>element_id = 'menu_traceability'</where>
            </delete>
        </rollback>
    </changeSet>
</databaseChangeLog>
