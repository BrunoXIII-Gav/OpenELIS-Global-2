<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet author="openelis" id="1">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT count(*) FROM clinlims.site_information WHERE name = 'Patient passport max length'</sqlCheck>
        </preConditions>
        <comment>Add configurable max length for patient passport identifier on patient entry</comment>
        <insert schemaName="clinlims" tableName="site_information">
            <column name="id" valueSequenceNext="site_information_seq" />
            <column name="name" value="Patient passport max length" />
            <column name="lastupdated" valueComputed="${now}" />
            <column name="description" value="Maximum allowed length for passport identifier on patient entry" />
            <column name="value" value="12" />
            <column name="encrypted" value="false" />
            <column name="domain_id" valueComputed="(SELECT id FROM site_information_domain WHERE name = 'patientEntryConfig')" />
            <column name="value_type" value="text" />
            <column name="group" value="0" />
            <column name="description_key" value="siteInfo.patient.passport.max.length" />
        </insert>
    </changeSet>
</databaseChangeLog>
