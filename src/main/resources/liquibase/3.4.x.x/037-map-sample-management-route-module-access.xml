<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <changeSet id="037-map-sample-management-route-module-access" author="codex">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="system_module_url" schemaName="clinlims" />
      <sqlCheck expectedResult="1">
        SELECT COUNT(*) FROM clinlims.system_module WHERE name = 'GenericSampleView'
      </sqlCheck>
      <sqlCheck expectedResult="0">
        SELECT COUNT(*)
        FROM clinlims.system_module_url
        WHERE url_path = '/SampleManagement'
      </sqlCheck>
    </preConditions>

    <comment>Allow Sample Management page route for users with GenericSampleView module access</comment>
    <insert tableName="system_module_url" schemaName="clinlims">
      <column name="id" valueSequenceNext="system_module_url_seq"/>
      <column name="url_path" value="/SampleManagement"/>
      <column name="system_module_id"
              valueComputed="(SELECT id FROM clinlims.system_module WHERE name = 'GenericSampleView')"/>
    </insert>
  </changeSet>

</databaseChangeLog>
