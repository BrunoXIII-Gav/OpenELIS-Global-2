<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <changeSet id="073-01-create-role-module-permission" author="openelis">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="role_module_permission" schemaName="clinlims" />
      </not>
    </preConditions>

    <createTable tableName="role_module_permission" schemaName="clinlims">
      <column name="id" type="SERIAL">
        <constraints primaryKey="true" nullable="false" />
      </column>
      <column name="role_id" type="INTEGER">
        <constraints nullable="false" />
      </column>
      <column name="module_key" type="VARCHAR(80)">
        <constraints nullable="false" />
      </column>
      <column name="action_key" type="VARCHAR(80)">
        <constraints nullable="false" />
      </column>
      <column name="all_lab_units" type="BOOLEAN" defaultValueBoolean="true">
        <constraints nullable="false" />
      </column>
      <column name="last_updated" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false" />
      </column>
    </createTable>

    <addUniqueConstraint tableName="role_module_permission" schemaName="clinlims"
      columnNames="role_id, module_key, action_key"
      constraintName="uq_role_module_permission_role_module_action" />

    <addForeignKeyConstraint baseTableName="role_module_permission" baseColumnNames="role_id"
      baseTableSchemaName="clinlims" constraintName="fk_role_module_permission_role"
      referencedTableName="system_role" referencedColumnNames="id" referencedTableSchemaName="clinlims" />

    <rollback>
      <dropTable tableName="role_module_permission" schemaName="clinlims" />
    </rollback>
  </changeSet>

  <changeSet id="073-02-create-role-module-permission-lab-unit-scope" author="openelis">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="role_module_permission_lab_unit_scope" schemaName="clinlims" />
      </not>
    </preConditions>

    <createTable tableName="role_module_permission_lab_unit_scope" schemaName="clinlims">
      <column name="id" type="SERIAL">
        <constraints primaryKey="true" nullable="false" />
      </column>
      <column name="role_module_permission_id" type="INTEGER">
        <constraints nullable="false" />
      </column>
      <column name="lab_unit_id" type="VARCHAR(64)">
        <constraints nullable="false" />
      </column>
      <column name="last_updated" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false" />
      </column>
    </createTable>

    <addUniqueConstraint tableName="role_module_permission_lab_unit_scope" schemaName="clinlims"
      columnNames="role_module_permission_id, lab_unit_id"
      constraintName="uq_role_module_permission_lab_unit_scope" />

    <addForeignKeyConstraint baseTableName="role_module_permission_lab_unit_scope"
      baseColumnNames="role_module_permission_id" baseTableSchemaName="clinlims"
      constraintName="fk_role_module_permission_lab_unit_scope_permission"
      referencedTableName="role_module_permission" referencedColumnNames="id" referencedTableSchemaName="clinlims" />

    <rollback>
      <dropTable tableName="role_module_permission_lab_unit_scope" schemaName="clinlims" />
    </rollback>
  </changeSet>
</databaseChangeLog>
