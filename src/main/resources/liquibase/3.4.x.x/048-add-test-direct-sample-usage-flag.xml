<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="048-add-test-direct-sample-usage-flag-column" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists schemaName="clinlims" tableName="test" columnName="direct_sample_usage_enabled" />
            </not>
        </preConditions>

        <addColumn schemaName="clinlims" tableName="test">
            <column name="direct_sample_usage_enabled" type="boolean" defaultValueBoolean="false" />
        </addColumn>

        <rollback>
            <dropColumn schemaName="clinlims" tableName="test" columnName="direct_sample_usage_enabled" />
        </rollback>
    </changeSet>
</databaseChangeLog>
