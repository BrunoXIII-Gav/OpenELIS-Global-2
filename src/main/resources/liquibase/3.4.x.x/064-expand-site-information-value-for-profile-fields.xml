<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <changeSet id="064-01-expand-site-information-value-to-text" author="openelis">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists schemaName="clinlims" tableName="site_information"/>
        <columnExists schemaName="clinlims" tableName="site_information" columnName="value"/>
        <not>
          <sqlCheck expectedResult="1">
            SELECT CASE
              WHEN data_type = 'text' THEN 1
              ELSE 0
            END
            FROM information_schema.columns
            WHERE table_schema = 'clinlims'
              AND table_name = 'site_information'
              AND column_name = 'value'
          </sqlCheck>
        </not>
      </and>
    </preConditions>

    <modifyDataType
      schemaName="clinlims"
      tableName="site_information"
      columnName="value"
      newDataType="TEXT"/>

    <rollback>
      <modifyDataType
        schemaName="clinlims"
        tableName="site_information"
        columnName="value"
        newDataType="VARCHAR(200)"/>
    </rollback>
  </changeSet>

</databaseChangeLog>
