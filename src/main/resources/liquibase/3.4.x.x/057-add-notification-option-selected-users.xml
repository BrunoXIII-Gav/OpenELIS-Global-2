<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <changeSet id="057-01-create-notification-option-selected-users" author="openelis">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="notification_config_option_user"/>
      </not>
    </preConditions>

    <createTable tableName="notification_config_option_user">
      <column name="notification_config_option_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="system_user_id" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addForeignKeyConstraint
      baseTableName="notification_config_option_user"
      baseColumnNames="notification_config_option_id"
      constraintName="fk_notif_option_user_option"
      referencedTableName="notification_config_option"
      referencedColumnNames="id"
      onDelete="CASCADE"/>

    <createIndex
      tableName="notification_config_option_user"
      indexName="idx_notif_option_user_option">
      <column name="notification_config_option_id"/>
    </createIndex>

    <createIndex
      tableName="notification_config_option_user"
      indexName="idx_notif_option_user_system_user">
      <column name="system_user_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
