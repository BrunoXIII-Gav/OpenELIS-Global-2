<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
 <changeSet id="085-test-configuration-packages" author="openelis">
  <createTable tableName="test_configuration_revision" schemaName="clinlims">
   <column name="last_updated" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
   <column name="id" type="VARCHAR(36)"><constraints primaryKey="true" nullable="false"/></column>
   <column name="fingerprint" type="VARCHAR(64)"><constraints unique="true" nullable="false"/></column>
   <column name="family_key" type="VARCHAR(64)"><constraints nullable="false"/></column>
   <column name="package_json" type="TEXT"><constraints nullable="false"/></column>
   <column name="mapping_json" type="TEXT"><constraints nullable="false"/></column>
   <column name="actor_id" type="VARCHAR(40)"><constraints nullable="false"/></column>
   <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
  </createTable>
  <createIndex tableName="test_configuration_revision" schemaName="clinlims" indexName="idx_test_config_revision_family"><column name="family_key"/></createIndex>
  <createTable tableName="test_configuration_identity" schemaName="clinlims">
   <column name="last_updated" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
   <column name="entity_key" type="VARCHAR(140)"><constraints primaryKey="true" nullable="false"/></column>
   <column name="source_key" type="VARCHAR(100)"><constraints nullable="false"/></column>
   <column name="revision_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
  </createTable>
  <addForeignKeyConstraint baseTableName="test_configuration_identity" baseTableSchemaName="clinlims" baseColumnNames="revision_id" referencedTableName="test_configuration_revision" referencedTableSchemaName="clinlims" referencedColumnNames="id" constraintName="fk_test_config_identity_revision"/>
  <createTable tableName="test_configuration_import_lock" schemaName="clinlims">
   <column name="last_updated" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
   <column name="id" type="INTEGER"><constraints primaryKey="true" nullable="false"/></column>
   <column name="origin_key" type="VARCHAR(36)"><constraints nullable="false"/></column>
  </createTable>
  <insert tableName="test_configuration_import_lock" schemaName="clinlims"><column name="id" valueNumeric="1"/><column name="origin_key" valueComputed="gen_random_uuid()"/></insert>
  <rollback>
   <dropTable tableName="test_configuration_import_lock" schemaName="clinlims"/>
   <dropTable tableName="test_configuration_identity" schemaName="clinlims"/>
   <dropTable tableName="test_configuration_revision" schemaName="clinlims"/>
  </rollback>
 </changeSet>
</databaseChangeLog>
