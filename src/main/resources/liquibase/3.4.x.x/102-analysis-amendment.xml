<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">
 <changeSet id="102-analysis-amendment-columns" author="openelis">
  <!-- A correction after delivery is a new analysis that points to the one it
       amends. The original keeps its own cycle; at most one direct amendment. -->
  <addColumn schemaName="clinlims" tableName="analysis">
   <column name="amends_analysis_id" type="NUMERIC(10,0)">
    <constraints unique="true" uniqueConstraintName="uk_analysis_amends_analysis"
     foreignKeyName="fk_analysis_amends_analysis" referencedTableSchemaName="clinlims"
     referencedTableName="analysis" referencedColumnNames="id"/>
   </column>
   <column name="amendment_reason" type="varchar(255)"/>
  </addColumn>
 </changeSet>
</databaseChangeLog>
