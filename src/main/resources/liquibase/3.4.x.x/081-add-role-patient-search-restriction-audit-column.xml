<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
  <changeSet id="081-01-add-role-patient-search-restriction-audit-column" author="openelis">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="role_patient_search_restriction" schemaName="clinlims" />
        <not>
          <columnExists tableName="role_patient_search_restriction" columnName="last_updated" schemaName="clinlims" />
        </not>
      </and>
    </preConditions>
    <addColumn tableName="role_patient_search_restriction" schemaName="clinlims">
      <column name="last_updated" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false" />
      </column>
    </addColumn>
    <rollback>
      <dropColumn tableName="role_patient_search_restriction" columnName="last_updated" schemaName="clinlims" />
    </rollback>
  </changeSet>
</databaseChangeLog>
