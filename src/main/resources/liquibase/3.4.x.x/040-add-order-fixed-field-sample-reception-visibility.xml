<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <changeSet id="040-01-add-show-in-sample-reception-to-order-fixed-field-config" author="openelis">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="order_fixed_field_config"/>
        <not>
          <columnExists tableName="order_fixed_field_config" columnName="show_in_sample_reception"/>
        </not>
      </and>
    </preConditions>

    <addColumn tableName="order_fixed_field_config">
      <column name="show_in_sample_reception" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
    </addColumn>

    <rollback>
      <dropColumn tableName="order_fixed_field_config" columnName="show_in_sample_reception"/>
    </rollback>
  </changeSet>

</databaseChangeLog>
