        JOIN clinlims.system_module m ON m.id = rm.system_module_id
        WHERE r.name = 'Storage' AND m.name = 'Storage'
      </sqlCheck>
    </preConditions>

    <comment>Grant Storage role access to Storage module</comment>
    <insert schemaName="clinlims" tableName="system_role_module">
      <column name="id" valueSequenceNext="system_role_module_seq" />
      <column name="has_select" value="Y" />
      <column name="has_add" value="Y" />
      <column name="has_update" value="Y" />
