  <changeSet id="018-13-map-role-module-aliquot" author="codex">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="system_role_module" schemaName="clinlims" />
      <sqlCheck expectedResult="1">SELECT COUNT(*) FROM clinlims.system_role WHERE name = 'Aliquot'</sqlCheck>
      <sqlCheck expectedResult="1">SELECT COUNT(*) FROM clinlims.system_module WHERE name = 'Aliquot'</sqlCheck>
      <sqlCheck expectedResult="0">
        SELECT COUNT(*)
        FROM clinlims.system_role_module rm
        JOIN clinlims.system_role r ON r.id = rm.system_role_id
        JOIN clinlims.system_module m ON m.id = rm.system_module_id
        WHERE r.name = 'Aliquot' AND m.name = 'Aliquot'
      </sqlCheck>
    </preConditions>

    <comment>Grant Aliquot role access to Aliquot module</comment>
    <insert schemaName="clinlims" tableName="system_role_module">
      <column name="id" valueSequenceNext="system_role_module_seq" />
      <column name="has_select" value="Y" />
      <column name="has_add" value="Y" />
      <column name="has_update" value="Y" />
      <column name="has_delete" value="Y" />
      <column name="system_role_id" valueComputed="(SELECT id FROM clinlims.system_role WHERE name = 'Aliquot')" />
      <column name="system_module_id" valueComputed="(SELECT id FROM clinlims.system_module WHERE name = 'Aliquot')" />
    </insert>
  </changeSet>

