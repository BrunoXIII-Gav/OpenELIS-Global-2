  <changeSet id="018-01-add-role-aliquot" author="codex">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="system_role" schemaName="clinlims" />
      <sqlCheck expectedResult="1">SELECT COUNT(*) FROM clinlims.system_role WHERE name = 'Lab Unit Roles'</sqlCheck>
      <sqlCheck expectedResult="0">SELECT COUNT(*) FROM clinlims.system_role WHERE name = 'Aliquot'</sqlCheck>
    </preConditions>

    <comment>Create Aliquot role under Lab Unit Roles</comment>
    <insert schemaName="clinlims" tableName="system_role">
      <column name="id" valueSequenceNext="system_role_seq" />
      <column name="name" value="Aliquot" />
      <column name="description" value="Access to aliquot workflow" />
      <column name="is_grouping_role" valueBoolean="false" />
      <column name="grouping_parent" valueComputed="(SELECT id FROM clinlims.system_role WHERE name = 'Lab Unit Roles')" />
      <column name="display_key" value="role.aliquot" />
      <column name="active" valueBoolean="true" />
      <column name="editable" valueBoolean="false" />
    </insert>
  </changeSet>

