      <sqlCheck expectedResult="0">SELECT COUNT(*) FROM clinlims.system_module_url WHERE url_path = '/Aliquot'</sqlCheck>
    </preConditions>

    <comment>Bind /Aliquot route to Aliquot module</comment>
    <insert schemaName="clinlims" tableName="system_module_url">
