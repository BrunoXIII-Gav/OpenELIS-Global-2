<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">
 <changeSet id="cug-test-baseline" author="openelis">
  <createTable tableName="patient"><column name="id" type="NUMERIC(10,0)"><constraints primaryKey="true"/></column></createTable>
  <createTable tableName="sample"><column name="id" type="NUMERIC(10,0)"><constraints primaryKey="true"/></column></createTable>
  <createTable tableName="site_information">
   <column name="name" type="VARCHAR(128)"/>
   <column name="value" type="VARCHAR(128)"/>
  </createTable>
  <createTable tableName="sample_item">
   <column name="id" type="INTEGER"><constraints primaryKey="true"/></column>
   <column name="cug_code" type="VARCHAR(128)"/>
   <column name="sys_user_id" type="INTEGER"/>
  </createTable>
  <createSequence sequenceName="sample_cug_prefix_seq" startValue="140"/>
  <sql>SELECT nextval('clinlims.sample_cug_prefix_seq')</sql>
 </changeSet>
 <include file="liquibase/3.4.x.x/031-create-sample-cug-reservation.xml"/>
 <include file="liquibase/3.4.x.x/094-training-cleanup-code-reset.xml"/>
 <include file="liquibase/audit-baseline.xml"/>
 <include file="liquibase/3.4.x.x/088-complete-audit-trail.xml"/>
 <include file="liquibase/3.4.x.x/089-audit-test-filter.xml"/>
</databaseChangeLog>
