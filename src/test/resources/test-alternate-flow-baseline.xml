<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="alternate-flow-test-baseline"
        author="openelis">
        <createTable tableName="test">
            <column name="id" type="integer">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="skip_validation_when_parent_complete"
                type="boolean" defaultValueBoolean="false" />
        </createTable>
        <rollback>
            <dropTable tableName="test" />
        </rollback>
    </changeSet>
    <changeSet id="alternate-flow-existing-test"
        author="openelis" context="populated">
        <insert tableName="test">
            <column name="id" valueNumeric="1" />
            <column name="skip_validation_when_parent_complete"
                valueBoolean="true" />
        </insert>
        <rollback>
            <delete tableName="test">
                <where>id = 1</where>
            </delete>
        </rollback>
    </changeSet>
    <changeSet id="alternate-flow-new-test" author="openelis"
        context="after">
        <insert tableName="test">
            <column name="id" valueNumeric="2" />
        </insert>
        <rollback>
            <delete tableName="test">
                <where>id = 2</where>
            </delete>
        </rollback>
    </changeSet>
</databaseChangeLog>
