#!/bin/bash
# Validate without changing files or staging work the user did not select.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if git diff --cached --quiet; then
    exit 0
fi

bash "$REPO_ROOT/scripts/check-format.sh"

# Keep Catalyst's Python checks aligned with its CI, without automatic fixes.
for project in catalyst-agents catalyst-gateway catalyst-mcp; do
    project_prefix="projects/catalyst/$project/"
    paths=()
    while IFS= read -r -d '' file; do
        if [[ "$file" == "$project_prefix"*.py ]]; then
            paths+=("${file#"$project_prefix"}")
        fi
    done < <(git diff --cached --name-only --diff-filter=ACMR -z)
    if ((${#paths[@]})); then
        (
            cd "$project_prefix"
            uv run ruff format --check "${paths[@]}"
            uv run ruff check "${paths[@]}"
        )
    fi
done
